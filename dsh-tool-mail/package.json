{
  "name": "@hawkol/dsh-tool-mail",
  "description": "Model-facing mail tools (send / list / read / reply) over Tencent Agent Mail for DeepSeek Harness",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
